# ── E-discussion backend — variables d'environnement ─────────────────────────
# Copier en `.env` et remplir. Ne jamais committer `.env`.

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=E-discussion
ENV=development                       # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://127.0.0.1:19000

# ── i18n ────────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en,es,ar,pt

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ediscussion:ediscussion@localhost:5432/ediscussion

# ── Redis (presence, pub/sub WebSocket, cache OTP) ──────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

# ── OTP / verification ─────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Twilio (SMS OTP) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ── Email (verification mail + reset password) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="E-discussion <no-reply@ediscussion.app>"

# ── Cloudinary (upload medias) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Firebase Cloud Messaging (push) ──────────────────────────────────────
FCM_CREDENTIALS_FILE=firebase-service-account.json

# ── LiveKit (appels WebRTC — SFU auto-heberge, PAS LiveKit Cloud) ───────
# URL wss:// publique de VOTRE serveur LiveKit (Docker sur le VPS).
LIVEKIT_URL=wss://sfu.gofolyx.com
# Doivent correspondre a une paire keys: du livekit.yaml du serveur SFU.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Duree de validite d'un token d'acces a une room (secondes).
LIVEKIT_TOKEN_TTL=3600
# Au-dela de ce delai sans reponse, l'appel bascule en "missed" (secondes).
CALL_RING_TIMEOUT=45
