# Configuration du serveur LiveKit auto-hébergé.
# Copiez en livekit.yaml et remplacez les valeurs marquées CHANGEZ-MOI.

port: 7880

rtc:
  # Ports média WebRTC (RTP/UDP). Doivent être ouverts dans le pare-feu.
  udp_port: 50000-50100
  # Fallback WebRTC-over-TCP quand l'UDP est bloqué côté client.
  tcp_port: 7881
  # IP publique du VPS. "true" = auto-détection via STUN au démarrage.
  # Mettez l'IP en dur si l'auto-détection échoue (VPS derrière NAT/1:1).
  use_external_ip: true
  # external_ip: 203.0.113.10

redis:
  address: 127.0.0.1:6389

# Paires de clés API : <clé>: <secret> (secret ≥ 32 caractères).
# LA MÊME PAIRE doit être dans le .env du backend :
#   LIVEKIT_API_KEY=<clé>
#   LIVEKIT_API_SECRET=<secret>
# Générez-en une : docker run --rm livekit/livekit-server generate-keys
keys:
  CHANGEZ_MOI_CLE: CHANGEZ_MOI_SECRET_AU_MOINS_32_CARACTERES

# Webhook : LiveKit notifie le backend des événements de room
# (room_started, room_finished, participant_left…). Sert de filet de
# sécurité pour clôturer un CallLog si un participant crashe.
# La requête est signée avec la clé API ci-dessus (en-tête Authorization) —
# le backend la vérifie via WebhookReceiver, pas besoin d'auth supplémentaire.
webhook:
  api_key: CHANGEZ_MOI_CLE
  urls:
    - https://api.gofolyx.com/api/v1/calls/webhooks/livekit

# Room : fermeture automatique quand elle se vide (appel 1-to-1 terminé).
room:
  auto_create: true
  empty_timeout: 20        # secondes après le départ du dernier participant
  departure_timeout: 20
  max_participants: 2       # appels 1-to-1 uniquement

# Logs
logging:
  level: info
  json: false

# TURN intégré : indispensable pour les clients derrière un NAT strict /
# pare-feu d'entreprise. Nécessite un certificat TLS pour le domaine.
turn:
  enabled: true
  domain: sfu.gofolyx.com
  tls_port: 5349
  udp_port: 3478
  # Chemins vers le certificat (montez-les dans le conteneur si besoin).
  # Laissez vide pour utiliser Let's Encrypt automatique (port 443 requis).
  # cert_file: /etc/livekit/cert.pem
  # key_file: /etc/livekit/key.pem
