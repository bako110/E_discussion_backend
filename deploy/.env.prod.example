# E-discussion backend — .env de PRODUCTION (VPS).
# Copié en deploy/.env par le script de déploiement, valeurs à compléter.

# ── App ────────────────────────────────────────────────────────────────
APP_NAME=E-discussion
ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://msg.gofolyx.com,capacitor://localhost,http://localhost

DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en

# ── PostgreSQL / Redis (surchargés par docker-compose.prod.yml) ────────
POSTGRES_USER=ediscussion
POSTGRES_DB=ediscussion
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

# ── OTP ────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Twilio (SMS OTP) — laisser vide = OTP loggé en console ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ── Email ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=E-discussion <no-reply@gofolyx.com>

# ── Médias ─────────────────────────────────────────────────────────────
MEDIA_ROOT=media
MEDIA_URL_PREFIX=/media
MEDIA_PUBLIC_BASE=https://msg.gofolyx.com
MAX_UPLOAD_MB=80

# ── FCM (push) — optionnel ────────────────────────────────────────────
FCM_CREDENTIALS_FILE=firebase-service-account.json

# ── LiveKit (SFU auto-hébergé) — rempli par le script ────────────────
LIVEKIT_URL=wss://sfu.gofolyx.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=3600
CALL_RING_TIMEOUT=45
